{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/categories/str-owners/",
      "destination": "/case-studies/short-term-rental/",
      "permanent": true
    },
    {
      "source": "/categories/str-owners",
      "destination": "/case-studies/short-term-rental/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/guides/",
      "permanent": true
    },
    {
      "source": "/categories/:path*",
      "destination": "/guides/",
      "permanent": true
    }
  ],
  "buildCommand": "node scripts/seo-production.cjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
