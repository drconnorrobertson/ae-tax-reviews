{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/blog/:path*",
      "destination": "/guides/",
      "permanent": true
    },
    {
      "source": "/categories/:path*",
      "destination": "/guides/",
      "permanent": true
    }
  ],
  "buildCommand": "node topical-depth-build.cjs",
  "outputDirectory": "public"
}
