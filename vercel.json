{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/blog/:path*",
      "destination": "/guides/",
      "permanent": true
    },
    {
      "source": "/categories/:path*",
      "destination": "/guides/",
      "permanent": true
    }
  ],
  "buildCommand": "node topical-depth-build.cjs && node brand-build.cjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
